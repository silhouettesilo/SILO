# Local development template. Never commit .env or real credentials.

NODE_ENV=development
PORT=3000
SILO_HOST=127.0.0.1

# Generate separate secrets using: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
MFA_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
SILO_SETUP_KEY=replace-with-a-private-random-setup-key

APP_URL=http://localhost:3000

# Local AI development
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=120000

# Hosted AI for production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=90000
AI_FALLBACK_PROVIDER=

# Optional estimated token costs; configure both or neither
AI_INPUT_COST_PER_MILLION_USD=
AI_OUTPUT_COST_PER_MILLION_USD=

# Required for production email
RESEND_API_KEY=
EMAIL_FROM=SILO <noreply@example.com>

# Optional until Stripe billing is configured
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
